{
  "name": "tweetme-frontend",
  "version": "1.0.0",
  "description": "Frontend for TweetMe social media platform built with React and Redux",
  "main": "index.js",
  "scripts": {
    "dev:build-server": "webpack --config webpack.server.js --watch",
    "dev:build-client": "webpack --config webpack.client.js --watch",
    "dev:server": "nodemon --watch serverJS --exec \"node serverJS/bundle.js\"",
    "build-client": "webpack-dev-server --config webpack.client.js --hot --inline --open --progress",
    "build-dev": "npm-run-all --parallel dev:*",
    "start": "npm run build-client",
    "build": "webpack --config webpack.client.js --mode production"
  },
  "browserslist": [
    "> .3%",
    "last 5 versions",
    "not dead"
  ],
  "keywords": [
    "react",
    "redux",
    "social-media", 
    "twitter-clone",
    "django",
    "full-stack",
    "javascript",
    "webpack"
  ],
  "author": "TweetMe Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/tweetme.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/tweetme/issues"
  },
  "homepage": "https://github.com/your-username/tweetme#readme",
